{
  "name": "@dsh-hardware-buddy/dsh-hardware-buddy",
  "version": "0.1.0",
  "description": "DeepSeek Harness host plugin that mirrors agent state to a CodeBuddy StickS3 pet over USB CDC and routes physical A/B approval back into the approval waterfall.",
  "type": "module",
  "main": "dist/index.js",
