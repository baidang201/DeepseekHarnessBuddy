  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
